# Copy to .env and set the two passwords. Docker Compose and the wikilense package both read this file.
WIKILENSE_DB_HOST=127.0.0.1
WIKILENSE_DB_PORT=3306
WIKILENSE_DB_NAME=wikilense
WIKILENSE_DB_USER=wikilense
WIKILENSE_DB_PASSWORD=change-me
WIKILENSE_DB_ROOT_PASSWORD=change-me-too

# Retrieval settings (defaults chosen with results/SUMMARY.md; override to experiment)
# WIKILENSE_CHUNK_MAX_WORDS=240
# WIKILENSE_CHUNK_OVERLAP_UNITS=1
# WIKILENSE_EF_SEARCH=100
# WIKILENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# The vector index M (16) is not a setting: it is written in sql/schema.sql.
